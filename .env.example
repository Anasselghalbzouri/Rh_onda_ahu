# Variables lues par docker-compose (racine). Copiez ce fichier en `.env`
# puis renseignez une clé d'application stable :
#
#   docker compose run --rm backend php artisan key:generate --show
#
# Collez la valeur (format base64:...) ci-dessous. La clé doit rester STABLE
# (ne pas la régénérer à chaque démarrage).
APP_KEY=
